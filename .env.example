# Instana Configuration
# Copy this file to .env and fill in your Instana credentials
# DO NOT commit .env file to Git

# Instana Agent Configuration (for backend and Java service)
INSTANA_AGENT_KEY=your-instana-agent-key-here
INSTANA_AGENT_ENDPOINT=ingress-magenta-saas.instana.rocks
INSTANA_AGENT_PORT=443

# Instana EUM Configuration (for frontend)
INSTANA_EUM_KEY=your-instana-eum-key-here
INSTANA_EUM_ENDPOINT=eum-magenta-saas.instana.rocks
